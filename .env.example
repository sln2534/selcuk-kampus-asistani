# Bu dosyayı .env olarak kopyalayın ve doldurun. .env ASLA GitHub'a yüklenmez.

# BotFather'dan alınan token
TELEGRAM_BOT_TOKEN=

# https://aistudio.google.com/apikey adresinden ücretsiz anahtar
GEMINI_API_KEY=
# Güncel ücretsiz Flash modelinin adını AI Studio'dan kontrol edin
GEMINI_MODEL=gemini-3.1-flash-lite
# Ana model meşgulse sırayla denenecek yedek modeller (virgülle ayırın)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Bot -> API adresi (docker compose içinde http://api:8000)
API_URL=http://localhost:8000

# Anonim kullanıcı sayımı için rastgele bir değer yazın
STATS_SALT=buraya-rastgele-uzun-bir-metin

# Daha önce doğru cevaplanmış soruları Gemini'ye gitmeden hafızadan ver (true/false)
CACHE_ENABLED=true
